+    WiFi.mode(WIFI_STA);
+#ifdef ARDUINO_ARCH_ESP32
+    WiFi.setTxPower(wifi_power_t(txPower));
+    WiFi.setSleep(false);
+#endif
+  } else if (!WLED_WIFI_CONFIGURED) {
     DEBUG_PRINTLN(F("No connection configured."));
     if (!apActive) initAP();        // instantly go to ap mode
   } else if (!apActive) {
@@ -738,7 +769,7 @@ void WLED::initConnection()
     }
   }
 
-  if (WLED_WIFI_CONFIGURED) {
+  if (WLED_WIFI_CONFIGURED && !espNowOnlyChannel) {
     showWelcomePage = false;
     
     DEBUG_PRINTF_P(PSTR("Connecting to %s...\n"), multiWiFi[selectedWiFi].clientSSID);
@@ -805,11 +836,15 @@ void WLED::initConnection()
   }
 
 #ifndef WLED_DISABLE_ESPNOW
-  if (enableESPNow) {
+  if (enableESPNow || espNowOnlyChannel) {
+    QuickEspNowReset::beforeBegin(quickEspNow, espNowStopped);
+    espNowStopped = false;
     quickEspNow.onDataSent(espNowSentCB);     // see udp.cpp
     quickEspNow.onDataRcvd(espNowReceiveCB);  // see udp.cpp
     bool espNowOK;
-    if (apActive) {
+    if (espNowOnlyChannel) {
+      espNowOK = quickEspNow.begin(espNowOnlyChannel, WIFI_IF_STA);  // WLED Link: a fixed channel, the bridge's
+    } else if (apActive) {
       DEBUG_PRINTLN(F("ESP-NOW initing in AP mode."));
       #ifdef ESP32
       quickEspNow.setWiFiBandwidth(WIFI_IF_AP, WIFI_BW_HT20); // Only needed for ESP32 in case you need coexistence with ESP8266 in the same network
@@ -888,6 +923,14 @@ void WLED::handleConnection()
   #endif
   const bool wifiConfigured = WLED_WIFI_CONFIGURED;
 
+  if (espNowOnlyChannel) {  // WLED Link: no Wi-Fi network to look after
+    if (lastReconnectAttempt == 0 || forceReconnect) {
+      initConnection();
+      forceReconnect = false;
+    }
+    return;
+  }
+
   // ignore connection handling if WiFi is configured and scan still running
   // or within first 2s if WiFi is not configured or AP is always active
   if ((wifiConfigured && multiWiFi.size() > 1 && WiFi.scanComplete() < 0) || (now < 2000 && (!wifiConfigured || apBehavior == AP_BEHAVIOR_ALWAYS)))
@@ -944,7 +987,11 @@ void WLED::handleConnection()
       sendImprovStateResponse(0x03, true);
       improvActive = 2;
     }
-    if (now - lastReconnectAttempt > ((stac) ? 300000 : 18000) && wifiConfigured) {
+    // WLED Link: once connected, a lost network usually means the bridge ESP32 restarted or the PC it is
+    // plugged into woke up. Look for it every 5 s instead of every 18 s so the lights are back within seconds.
+    // Not when the AP should open on a lost connection (it needs 12 s without a try) or has clients.
+    const unsigned long retryMs = stac ? 300000 : (wasConnected && apBehavior != AP_BEHAVIOR_NO_CONN) ? 5000 : 18000;
+    if (now - lastReconnectAttempt > retryMs && wifiConfigured) {
       if (improvActive == 2) improvActive = 3;
       DEBUG_PRINTF_P(PSTR("Last reconnect (%lus) too old (@ %lus).\n"), lastReconnectAttempt/1000, nowS);
       if (++selectedWiFi >= multiWiFi.size()) selectedWiFi = 0; // we couldn't connect, try with another network from the list
