 }
 
 static bool inSameSubnet(const IPAddress &client) {
+  // WLED Link: loopback is the PC, relayed by the usermod over its encrypted and authenticated radio link
+  // (in ESP-NOW mode WLED has no network address of its own to compare with)
+  if (client[0] == 127) return true;
   return inSubnet(client, Network.localIP(), Network.subnetMask());
 }
 
