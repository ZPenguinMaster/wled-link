@@ -681,6 +682,27 @@ void WLED::initAP(bool resetAP)
   apActive = true;
 }
 
+#ifndef WLED_DISABLE_ESPNOW
+// WLED Link: QuickEspNow's stop() leaves its two queues behind and begin() makes new ones, so every
+// reconnect attempt lost ~1.2 KB (without its network WLED ran out of memory within minutes). And once
+// started on "the current channel" it ignores the channel given to any later begin().
+struct QuickEspNowReset : QuickEspNow {
+  static void beforeBegin(QuickEspNow& q, bool stopped) {
+    QueueHandle_t QuickEspNow::* tx = &QuickEspNowReset::tx_queue;
+    QueueHandle_t QuickEspNow::* rx = &QuickEspNowReset::rx_queue;
+    bool QuickEspNow::* follow = &QuickEspNowReset::followWiFiChannel;
+    if (stopped) {  // its tasks are gone and the radio was re-initialized since: nothing can use them now
+      if (q.*tx) vQueueDelete(q.*tx);
+      if (q.*rx) vQueueDelete(q.*rx);
+      q.*tx = nullptr;
+      q.*rx = nullptr;
+    }
+    q.*follow = false;  // begin() sets it again when it is asked to follow the Wi-Fi channel
+  }
+};
+static bool espNowStopped = false;
+#endif
+
 void WLED::initConnection()
 {
   DEBUG_PRINTF_P(PSTR("initConnection() called @ %lus.\n"), millis()/1000);
@@ -693,6 +715,7 @@ void WLED::initConnection()
     DEBUG_PRINTLN(F("ESP-NOW stopping."));
     quickEspNow.stop();
     statusESPNow = ESP_NOW_STATE_UNINIT;
+    espNowStopped = true;
   }
 #endif
 
